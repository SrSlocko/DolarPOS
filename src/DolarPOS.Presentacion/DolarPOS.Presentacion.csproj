<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DolarPOS.Presentacion</RootNamespace>
    <AssemblyName>DolarPOS</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- Permite compilar también en Linux/macOS (para CI); ejecutar requiere Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Necesario para leer los iconos del ImageList embebidos en FrmPuntoVenta.resx
         (serializados con el formato heredado de .NET Framework). Solo afecta a los
         recursos locales del formulario, que son de confianza. -->
    <EnableUnsafeBinaryFormatterResx>true</EnableUnsafeBinaryFormatterResx>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DolarPOS.Negocio\DolarPOS.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Production.json" Condition="Exists('appsettings.Production.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
